
import * as React from 'react';
import { useParams, useRouter, useSearchParams } from 'next/navigation';

type ItemStatus = 'not_started' | 'draft' | 'final' | 'ready' | 'partial';

type SectionItem = {
  code: string;            // nt "B1-1"
  title: string;
  status: ItemStatus;
  updatedAt?: string | null;
};

type SectionPayload = {
  ok: boolean;
  section?: {
    code: string;          // nt "B1"
    title?: string;
    draft: number;
    final: number;
    total: number;
    percent: number;       // 0..100
  };
  items?: SectionItem[];
  error?: string;
};

const cx = (...cls: (string | false | null | undefined)[]) => cls.filter(Boolean).join(' ');

function StatusPill({ status }: { status: ItemStatus }) {
  const map: Record<ItemStatus, string> = {
    not_started: 'bg-gray-100 text-gray-700',
    draft: 'bg-amber-100 text-amber-800',
    partial: 'bg-amber-100 text-amber-800',
    ready: 'bg-emerald-100 text-emerald-800',
    final: 'bg-emerald-100 text-emerald-800',
  };
  const label: Record<ItemStatus, string> = {
    not_started: 'Not started',
    draft: 'Draft',
    partial: 'In progress',
    ready: 'Final',
    final: 'Final',
  };
  return (
    <span className={cx('inline-flex items-center rounded-full px-2 py-1 text-xs font-medium', map[status])}>
      {label[status]}
    </span>
  );
}

export default function EsGliteSectionPage() {
  const params = useParams<{ code: string }>();   // "B1", "B2", ...
  const search = useSearchParams();
  const router = useRouter();
  const project = search.get('project') || '';

  const [loading, setLoading] = React.useState(true);
  const [err, setErr] = React.useState<string | null>(null);
  const [data, setData] = React.useState<SectionPayload | null>(null);

  React.useEffect(() => {
    let aborted = false;
    async function run() {
      if (!project || !params.code) return;
      setLoading(true);
      setErr(null);
      try {
        // Clientis võib vabalt relatiivset teed kasutada
        const res = await fetch(`/api/cdm/section?project=${encodeURIComponent(project)}&code=${encodeURIComponent(params.code)}`, {
          credentials: 'include',
        });
        const json: SectionPayload = await res.json();
        if (aborted) return;
        if (!json.ok) {
          setErr(json.error || 'Section load failed');
          setData(null);
        } else {
          setData(json);
        }
      } catch (e: any) {
        if (!aborted) setErr(e?.message || 'Network error');
      } finally {
        if (!aborted) setLoading(false);
      }
    }
    run();
    return () => { aborted = true; };
  }, [project, params.code]);

  if (!project) {
    return (
      <div className="mx-auto max-w-5xl p-6">
        <div className="rounded-md border border-amber-300 bg-amber-50 p-4">
          <div className="text-sm text-amber-800">
            Puudub <code>project</code> parameeter. Ava URL näiteks:
            <div className="mt-1 font-mono text-xs">/questionnaires/esglite/{params.code}?project=client-test1</div>
          </div>
        </div>
      </div>
    );
  }

  if (loading) {
    return (
      <div className="mx-auto max-w-5xl p-6">
        <div className="h-6 w-56 animate-pulse rounded bg-gray-200 mb-6" />
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          {Array.from({ length: 4 }).map((_, i) => (
            <div key={i} className="h-28 animate-pulse rounded-lg border border-gray-200 bg-gray-50" />
          ))}
        </div>
      </div>
    );
  }

  if (err) {
    return (
      <div className="mx-auto max-w-5xl p-6">
        <div className="rounded-md border border-rose-300 bg-rose-50 p-4 text-rose-800">
          Section load failed: {err}
        </div>
        <button
          className="mt-4 text-sm underline"
          onClick={() => router.push(`/questionnaires/esglite/nodes?project=${encodeURIComponent(project)}`)}
        >
          ← Back to all sections
        </button>
      </div>
    );
  }

  const section = data?.section;
  const items = data?.items || [];

  return (
    <div className="mx-auto max-w-5xl p-6">
      {/* Breadcrumbs */}
      <div className="mb-2 text-sm text-gray-500">
        <button
          className="underline underline-offset-2"
          onClick={() => router.push(`/questionnaires/esglite/nodes?project=${encodeURIComponent(project)}`)}
        >
          ESG-MASTER-01 / Questionnaires / ESGLITE sections
        </button>
        <span> / </span>
        <span className="text-gray-700">{section?.code || params.code}</span>
      </div>

      {/* Header */}
      <div className="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 className="text-xl font-semibold">
            Section {section?.code || params.code}
          </h1>
          <p className="mt-1 text-sm text-gray-600">
            Project: <span className="font-medium">{project}</span>
          </p>
        </div>
        <div className="text-right">
          <div className="text-sm text-gray-600">
            {section?.percent ?? 0}% — Final {section?.final ?? 0} / Total {section?.total ?? 0} (Draft {section?.draft ?? 0})
          </div>
        </div>
      </div>

      {/* Item cards */}
      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        {items.map((it) => (
          <div key={it.code} className="rounded-lg border border-gray-200 p-4">
            <div className="mb-1 flex items-center justify-between">
              <span className="text-xs font-mono text-gray-500">Code: {it.code}</span>
              <StatusPill status={it.status} />
            </div>
            <div className="text-sm font-medium text-gray-900">
              {it.title || 'Untitled item'}
            </div>
            {it.updatedAt && (
              <div className="mt-1 text-xs text-gray-500">
                Updated {new Date(it.updatedAt).toLocaleString()}
              </div>
            )}
            <div className="mt-3 flex items-center gap-2">
              <button
                onClick={() => router.push(`/esglite/item/${encodeURIComponent(it.code)}?project=${encodeURIComponent(project)}`)}
                className="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs hover:bg-gray-50"
              >
                Open
              </button>
              <button
                className="inline-flex items-center rounded-md border border-gray-200 bg-gray-50 px-3 py-1.5 text-xs text-gray-500 cursor-not-allowed"
                disabled
                title="Generic view WIP"
              >
                generic view WIP
              </button>
            </div>
          </div>
        ))}
        {items.length === 0 && (
          <div className="text-sm text-gray-500">No items in this section.</div>
        )}
      </div>
    </div>
  );
}

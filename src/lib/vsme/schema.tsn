// src/lib/vsme/schema.ts
// Server-side utiliidid VSME bundle'i lugemiseks ja skeemi tuvastamiseks.

import fs from "fs";
import path from "path";

const BUNDLE_PATH = path.join(process.cwd(), "src", "data", "vsme", "bundle.json");

type AnyRec = Record<string, any>;
export type VsmeBundle = AnyRec;
export type VsmeNode = AnyRec;

/** --- Helpers ------------------------------------------------------------ */

function getCode(n: VsmeNode | undefined): string | undefined {
  if (!n || typeof n !== "object") return undefined;
  return (
    n.code ??
    n.id ??
    n.key ??
    n?.attrs?.code ??
    n?.meta?.code ??
    undefined
  )?.toString();
}

function getChildren(n: VsmeNode | undefined): VsmeNode[] {
  if (!n || typeof n !== "object") return [];
  const c =
    n.children ??
    n.nodes ??
    n.items ??
    n.sections ??
    n.list ??
    [];
  return Array.isArray(c) ? c : [];
}

function flattenNodes(root: any): VsmeNode[] {
  const acc: VsmeNode[] = [];
  const stack: any[] = [];

  if (Array.isArray(root)) stack.push(...root);
  else if (root && typeof root === "object") {
    if (Array.isArray(root.nodes)) stack.push(...root.nodes);
    else stack.push(root);
  }

  while (stack.length) {
    const n = stack.pop();
    acc.push(n);
    const c = getChildren(n);
    for (const ch of c) stack.push(ch);
  }
  return acc;
}

/** --- Public API --------------------------------------------------------- */

export function readVsmeBundle(): VsmeBundle {
  const txt = fs.readFileSync(BUNDLE_PATH, "utf8");
  return JSON.parse(txt);
}

/** Näiteks "B1-1" -> "B1" (sektsiooni kood) */
export function inferSectionCode(itemCode: string | undefined | null): string | null {
  if (!itemCode) return null;
  const m = String(itemCode).trim().match(/^([A-Za-z]\d+)/);
  return m ? m[1].toUpperCase() : null;
}

export function findSection(sectionCode: string, bundle?: VsmeBundle): VsmeNode | undefined {
  const b = bundle ?? readVsmeBundle();
  const nodes = flattenNodes(b);
  const want = sectionCode.trim().toLowerCase();
  return nodes.find((n) => {
    const code = getCode(n)?.toLowerCase();
    return !!code && code === want && /^[a-z]\d+$/.test(code);
  });
}

export function findItemByCode(itemCode: string, bundle?: VsmeBundle): VsmeNode | undefined {
  const b = bundle ?? readVsmeBundle();
  const nodes = flattenNodes(b);
  const want = itemCode.trim().toLowerCase();
  return nodes.find((n) => getCode(n)?.toLowerCase() === want);
}

/** Valikute lugemine eri võtmetelt */
function grabOptionsFrom(n: VsmeNode | undefined): any[] {
  if (!n || typeof n !== "object") return [];
  const cands = [
    n.options,
    n.choices,
    n.values,
    n.items,
    n.answers,
    n?.attrs?.options,
    n?.meta?.options,
  ].filter(Boolean);
  for (const c of cands) {
    if (Array.isArray(c) && c.length) return c;
  }
  return [];
}

function normalizeOption(raw: any): { value: string; label: string } | null {
  if (raw == null) return null;
  if (typeof raw === "string") return { value: raw, label: raw };
  if (typeof raw === "number") return { value: String(raw), label: String(raw) };
  if (typeof raw === "object") {
    const value =
      raw.value ?? raw.code ?? raw.id ?? raw.key ?? raw.slug ?? raw.name ?? raw.title;
    const label =
      raw.label ?? raw.title ?? raw.name ?? raw.text ?? raw.caption ?? value;
    if (value == null) return null;
    return { value: String(value), label: String(label ?? value) };
  }
  return null;
}

export type FieldConfig =
  | { kind: "select"; options: { value: string; label: string }[] }
  | { kind: "text" };

/** Fallback-valikud tuntud koodidele */
const HARDCODED_OPTIONS: Record<string, { value: string; label: string }[]> = {
  "B1-1": [
    { value: "basic", label: "Basic module" },
    { value: "both", label: "Basic module and Comprehensive module" },
  ],
  "B1-2": [
    { value: "individual", label: "Individual" },
    { value: "consolidated", label: "Consolidated" },
  ],
};

export function getFieldConfig(node: VsmeNode): FieldConfig {
  const raw = grabOptionsFrom(node);
  const opts = raw.map(normalizeOption).filter(Boolean) as { value: string; label: string }[];
  if (opts.length) return { kind: "select", options: opts };

  const code = getCode(node);
  if (code && HARDCODED_OPTIONS[code]) {
    return { kind: "select", options: HARDCODED_OPTIONS[code] };
  }
  return { kind: "text" };
}O


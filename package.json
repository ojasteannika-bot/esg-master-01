{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:quick": "bash scripts/check.sh",
    "fix:quick": "bash scripts/fix.sh",
    "dev:restart": "lsof -nP -iTCP:3001 -sTCP:LISTEN | awk 'NR>1 {print $2}' | xargs -r kill; next dev -p 3001"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.74.0",
    "lucide-react": "^0.545.0",
    "next": "15.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "10.4.21",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "8.5.6",
    "prettier": "^3.3.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.1.14",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
